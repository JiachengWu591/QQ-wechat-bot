{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm build && pnpm --filter @shu/engine bundle"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "engine/*": "engine/" },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
