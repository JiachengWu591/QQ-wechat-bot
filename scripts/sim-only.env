# A copy of the console with only the simulated chats: no QQ, no WeChat, no reading the WeChat
# window, and its own data and ports, so it can run beside the installed app.
#   node --env-file=scripts/sim-only.env scripts/dev.mjs
SHU_CHANNELS=sim
SHU_DATA_DIR=.dev/sim-only
SHU_ENGINE_PORT=47841
SHU_WEB_PORT=5184
