# Copy to .env.local and fill in. .env.local is gitignored.
# Do not rename the key to ANTHROPIC_API_KEY: Claude Code would pick it up
# instead of your plan login, and API credits don't cover Claude Code.
SHU_ANTHROPIC_API_KEY=

# From the QQ open platform. AppSecret may only be shown once.
SHU_QQ_APP_ID=
SHU_QQ_APP_SECRET=
